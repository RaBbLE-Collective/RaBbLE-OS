# free-claude-code configuration
# ─────────────────────────────────────────────────────────────────────────────
# Source of truth for model routing. API keys are set separately (see below).
#
# To update routing:
#   1. Edit MODEL_* lines in this file
#   2. fcc-ctl sync          — apply routing to live config, restart service
#      OR: layerctl apply free-claude-code
#
# This file is version-controlled in RaBbLE-OS/config/RaBbLE/fcc.env.example
# Live config: ~/.config/RaBbLE/fcc.env  (gitignored — holds real keys)
# ─────────────────────────────────────────────────────────────────────────────

# ── Server auth ───────────────────────────────────────────────────────────────
# Token for the Admin UI at http://127.0.0.1:8082/admin
# localhost-only — fcc-no-auth is fine unless you expose the port
ANTHROPIC_AUTH_TOKEN=fcc-no-auth

# ── Model routing ─────────────────────────────────────────────────────────────
# Maps Claude tier names → provider:model
# Edit here → fcc-ctl sync to apply

# Default: NVIDIA NIM (free tier with nvapi key, 100+ models)
# Format: provider/model  (provider IDs: nvidia_nim, groq, cerebras, deepseek, open_router, …)
MODEL_HAIKU=nvidia_nim/nvidia/llama-3.1-nemotron-nano-8b-v1
MODEL_SONNET=nvidia_nim/qwen/qwen2.5-coder-32b-instruct
MODEL_OPUS=nvidia_nim/nvidia/llama-3.3-nemotron-super-49b-v1

# ── Alternative routing profiles (uncomment to switch) ────────────────────────

# Groq — fastest inference, free tier (~50 req/day on free, generous on paid)
# MODEL_HAIKU=groq/llama-3.1-8b-instant
# MODEL_SONNET=groq/llama-3.3-70b-versatile
# MODEL_OPUS=groq/llama-3.3-70b-versatile

# DeepSeek — near-frontier quality, very cheap
# MODEL_HAIKU=deepseek/deepseek-chat
# MODEL_SONNET=deepseek/deepseek-chat
# MODEL_OPUS=deepseek/deepseek-reasoner

# OpenRouter — aggregator, covers almost everything (needs $10 credit for non-:free)
# MODEL_HAIKU=open_router/google/gemma-3-12b-it:free
# MODEL_SONNET=open_router/google/gemini-2.5-flash-preview:free
# MODEL_OPUS=open_router/anthropic/claude-sonnet-4-6

# Cerebras — 700+ t/s, good for fast iteration
# MODEL_HAIKU=cerebras/llama-3.1-8b
# MODEL_SONNET=cerebras/llama-3.3-70b
# MODEL_OPUS=cerebras/llama-3.3-70b

# ── Provider API keys ─────────────────────────────────────────────────────────
# Set via: fcc-ctl key <KEYNAME> <VALUE>
# Keys stay in ~/.config/RaBbLE/fcc.env — never committed.

NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# ── Advanced ──────────────────────────────────────────────────────────────────
# FCC_PORT=8082
# FCC_HOST=127.0.0.1
