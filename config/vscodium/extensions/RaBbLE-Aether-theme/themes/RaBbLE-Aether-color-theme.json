  "tokenColors": [

    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6b6880", "fontStyle": "italic" }
    },
    {
      "name": "Todos and annotations in comments",
      "scope": ["comment keyword.codetag.notation", "comment.block.documentation keyword", "comment.block.documentation storage.type.class"],
      "settings": { "foreground": "#ff2d78", "fontStyle": "bold italic" }
    },
    {
      "name": "Doc comment params",
      "scope": ["comment.block.documentation variable.other"],
      "settings": { "foreground": "#ff79c6", "fontStyle": "italic" }
    },

    {
      "name": "Keywords",
      "scope": ["keyword", "keyword.operator.new", "keyword.other.using", "keyword.other.import", "keyword.control"],
      "settings": { "foreground": "#ff2d78", "fontStyle": "bold" }
    },
    {
      "name": "Keyword modifiers (abstract, static, etc.)",
      "scope": ["storage.modifier", "keyword.other.static", "keyword.other.abstract", "keyword.other.override"],
      "settings": { "foreground": "#ff2d78" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.separator.key-value"],
      "settings": { "foreground": "#ff79c6" }
    },

    {
      "name": "Storage types (var, let, const, function, class, etc.)",
      "scope": ["storage.type", "storage"],
      "settings": { "foreground": "#bf5fff", "fontStyle": "bold" }
    },

    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#50fa7b" }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape", "string.regexp constant.character.escape"],
      "settings": { "foreground": "#ff79c6" }
    },
    {
      "name": "Template literal punctuation ${}",
      "scope": ["punctuation.definition.template-expression"],
      "settings": { "foreground": "#ff2d78" }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#f1fa8c" }
    },
    {
      "name": "Regex special chars",
      "scope": ["string.regexp keyword.operator", "string.regexp constant.other.character-class"],
      "settings": { "foreground": "#ff79c6" }
