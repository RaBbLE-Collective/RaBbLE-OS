  "semanticTokenColors": {
    "keyword":                  { "foreground": "#ff2d78", "bold": true },
    "function":                 { "foreground": "#00f5ff" },
    "function.declaration":     { "foreground": "#00f5ff", "bold": true },
    "method":                   { "foreground": "#00f5ff" },
    "method.declaration":       { "foreground": "#00f5ff", "bold": true },
    "class":                    { "foreground": "#bf5fff", "bold": true },
