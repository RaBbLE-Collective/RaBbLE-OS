// ~/.config/fastfetch/config.jsonc — RaBbLE-OS system identity display
// Logo is generated: edit rabble-portals.base.txt, then run spells/fastfetch-fx.py.
// Full guide: RaBbLE-Grimoire/RaBbLE-OS/desktop/RaBbLE-OS-Desktop-Fastfetch.md
// Colors are raw SGR params: 256-color is "38;5;N" — bare "N" is silently ignored.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/rabble-portals.txt",
    "type": "file",
    "padding": {
      "top": 0,
      "left": 1
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;191;95;255",
      "title": "38;2;0;245;255",
      "separator": "38;2;107;104;128"
    },
    "percent": {
      "color": {
        "green": "38;2;0;245;255",
        "yellow": "38;2;255;121;198",
        "red": "38;2;255;45;120"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;0;245;255",
        "at": "38;2;107;104;128",
        "host": "38;2;255;45;120"
      }
    },
    "separator",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "38;2;0;245;255",
      "format": "{pretty-name}"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "38;2;0;245;255"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "38;2;0;245;255"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "38;2;0;245;255"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "38;2;191;95;255",
      "format": "{rpm} rpm, {flatpak-all} flatpak"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "38;2;191;95;255"
    },
    {
      "type": "display",
      "key": "Display",
      "keyColor": "38;2;191;95;255",
      "format": "{width}x{height} @ {refresh-rate} Hz, {inch}\""
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "38;2;191;95;255"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "38;2;255;121;198"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "38;2;255;121;198"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "38;2;255;121;198",
      "hideType": "integrated",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "38;2;255;121;198"
    },
    {
      "type": "swap",
      "key": "Swap",
      "keyColor": "38;2;255;45;120"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "38;2;255;45;120",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "Battery",
      "keyColor": "38;2;255;45;120"
    },
    {
      "type": "localip",
      "key": "IP",
      "keyColor": "38;2;255;45;120"
    },
    "break",
    {
      // RaBbLE palette strip — cyan, violet, pink, magenta, muted (RaBbLE-Palette.md),
      // not the terminal's ANSI colors. {#38;5;N} = 256-color escape, {#} = reset.
      "type": "custom",
      "format": " {#38;2;0;245;255}◆◆◆ {#38;2;191;95;255}◆◆◆ {#38;2;255;121;198}◆◆◆ {#38;2;255;45;120}◆◆◆ {#38;2;107;104;128}◆◆◆{#}"
    }
  ]
}
