// ~/.config/fastfetch/config.jsonc — RaBbLE-OS system identity display
// Logo is generated: edit rabble-portals.base.txt, then run spells/fastfetch-fx.py.
// Full guide: RaBbLE-Grimoire/RaBbLE-OS/desktop/RaBbLE-OS-Desktop-Fastfetch.md
// Colors are raw SGR params: 256-color is "38;5;N" — bare "N" is silently ignored.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/rabble-portals.txt",
    "type": "file",
    "padding": {
      "top": 0,
      "left": 1
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;5;135",
      "title": "38;5;51",
      "separator": "38;5;60"
    },
    "percent": {
      "color": {
        "green": "38;5;51",
        "yellow": "38;5;205",
        "red": "38;5;197"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;5;51",
        "at": "38;5;60",
        "host": "38;5;197"
      }
    },
    "separator",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "38;5;51",
      "format": "{pretty-name}"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "38;5;51"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "38;5;51"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "38;5;51"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "38;5;135"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "38;5;135"
    },
    {
      "type": "display",
      "key": "Display",
      "keyColor": "38;5;135",
      "format": "{width}x{height} @ {refresh-rate} Hz, {inch}\""
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "38;5;135"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "38;5;205"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "38;5;205"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "38;5;205",
      "hideType": "integrated",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "38;5;205"
    },
    {
      "type": "swap",
      "key": "Swap",
      "keyColor": "38;5;197"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "38;5;197",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "Battery",
      "keyColor": "38;5;197"
    },
    {
      "type": "localip",
      "key": "IP",
      "keyColor": "38;5;197"
    },
    "break",
    {
      // RaBbLE palette strip — cyan, violet, pink, magenta, muted (RaBbLE-Palette.md),
      // not the terminal's ANSI colors. {#38;5;N} = 256-color escape, {#} = reset.
      "type": "custom",
      "format": " {#38;5;51}◆◆◆ {#38;5;135}◆◆◆ {#38;5;205}◆◆◆ {#38;5;197}◆◆◆ {#38;5;60}◆◆◆{#}"
    }
  ]
}
