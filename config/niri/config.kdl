// RaBbLE-OS :: niri trial session (niri 26.04, Fedora 44 `updates`)
// Mirrors config/hypr/conf_d/{look,animations,input,env,autostart,keybinds,functionkeys}.lua
// Palette: RaBbLE-Grimoire/RaBbLE-Agent/RaBbLE-Palette.md only.
//   #ff2d78 magenta · #00f5ff cyan · #bf5fff violet · #0a0010 void · #2a2840 border
// Deploy: ./RaBbLE-OS-dotctl.sh apply niri  (live-reloaded by niri; validate: niri validate -c config.kdl)
// Bind map, gaps vs Hyprland: /tmp/rabble-crew/niri-trial.md

// Machine-specific bits (render GPU pin), generated at session start by rabble-gpu via the niri.service
// drop-in (config/systemd-user). Never edit. Missing = warning only.
include optional=true "machine.kdl"

// ── Outputs ──────────────────────────────────────────────────────────────────
// eDP-1 logical 1920x1200; HDMI-A-1 logical 1920x1080 sits above it (y = -1080).
output "eDP-1" {
    mode "3840x2400"
    scale 2
    position x=0 y=0
}
output "HDMI-A-1" {
    mode "2560x1440@75"
    scale 1.333333
    position x=0 y=-1080
    variable-refresh-rate
}

// ── Input ────────────────────────────────────────────────────────────────────
input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
        dwt
        drag true
        middle-emulation
        click-method "clickfinger"
        // Match Hyprland input.lua: its top-level sensitivity 0.2 + adaptive profile also applies
        // to the touchpad; niri's touchpad block defaults to speed 0, which felt different.
        accel-profile "adaptive"
        accel-speed 0.2
        scroll-factor 0.8
    }
    mouse {
        accel-profile "adaptive"
        accel-speed 0.2
    }
    focus-follows-mouse
}

// ── Environment ──────────────────────────────────────────────────────────────
// niri sets XDG_CURRENT_DESKTOP / XDG_SESSION_TYPE itself; HYPRCURSOR_* not needed.
environment {
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_STYLE_OVERRIDE "kvantum"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    GDK_BACKEND "wayland,x11,*"
    GTK_THEME "RaBbLE-Aether"
    GTK_USE_PORTAL "1"
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    _JAVA_AWT_WM_NONREPARENTING "1"
    SDL_VIDEODRIVER "wayland"
    EDITOR "nvim"
    VISUAL "nvim"
    TERMINAL "kitty"
    BROWSER "firefox"
}

cursor {
    // Bibata is not installed on this machine (manual download, see manifest.yml); Adwaita is.
    xcursor-theme "Adwaita"
    xcursor-size 24
}

// Server-side decorations: lets niri draw the border/shadow/radius uniformly.
prefer-no-csd
// Mod+F1 shows the hotkey cheat sheet (titles below); shown once at login until you know the keys.
hotkey-overlay {
}
screenshot-path "~/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ── Look (look.lua) ──────────────────────────────────────────────────────────
// Hyprland gaps_in 4 / gaps_out 10: niri `gaps` is the inner gap, struts add to the outer edge.
layout {
    gaps 4
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // The ring is off; the border carries the gradient, as in Hyprland (border_size 2).
    focus-ring {
        off
    }
    border {
        width 2
        active-gradient from="#ff2d78" to="#00f5ff" angle=45
        inactive-color "#2a2840"
        urgent-color "#ff2d78"
    }
    // Shadows OFF: a soft shadow is a per-window blurred layer repainted on every swipe frame.
    // Re-enable by replacing `off` with `on` (softness 16 was the tuned value).
    shadow {
        off
        softness 16
        spread 0
        offset x=0 y=4
        color "#bf5fff18"
        inactive-color "#0a001099"
    }
    // Tabbed columns (Mod+G, like i3 tabbed) get a small themed tab strip.
    tab-indicator {
        hide-when-single-tab
        position "top"
        width 4
        gap 4
        corner-radius 4
        active-gradient from="#ff2d78" to="#00f5ff" angle=45
        inactive-color "#2a2840"
    }
    struts {
        left 6
        right 6
        top 6
        bottom 6
    }
}

// Blur: niri blur is global (passes/offset/noise/saturation) and enabled per surface by rule.
// Hyprland's size 6 / passes 2 / noise 0.02 -> passes 1 offset 5: one pass costs half as much on the
// 3840x2400 panel; offset 5 keeps a similar blur radius. (Was passes 2 offset 3; lighter for swipes.)
// No equivalent for Hyprland's contrast 0.9 / brightness 0.8.
blur {
    passes 1
    offset 5
    noise 0.02
    saturation 1.0
}

// Rounding 10. Blur behind windows is OFF: it is the single biggest per-frame cost on the
// 3840x2400 panel, and the goal is a desktop that stays smooth at minimum clocks on battery.
// To restore the glass look, add inside this rule:
//     background-effect { blur true; xray true; }
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Default workspace groups, in order: Mod+1..4 land on these. Personal job names
// (Incenergy etc.) are user config, not shipped here. // workspace "comms"
workspace "RaBbLE"
workspace "personal"
workspace "work"
workspace "scratch"

// Backdrop between workspaces / in overview.
overview {
    backdrop-color "#0a0010"
}

// ── Animations ───────────────────────────────────────────────────────────────
// Feel target: instant, 1:1 with input, never slower than the user.
// Everything that follows a gesture or a keypress is a critically damped spring
// (damping-ratio 1.0: no overshoot, no wobble). Springs inherit the release velocity of a
// touchpad swipe, so the view keeps moving and settles; a fixed duration + curve restarts
// from rest and reads as a hitch. Only open/close (no gesture to inherit) use short fixed times.
// Gap: niri has no animated/rotating border gradient (Hyprland `borderangle` loop).
//      The 45 degree magenta -> cyan border is static. Not faked.
animations {
    // Sideways swipe / focus-column scroll: tracks the finger 1:1, then settles in ~100 ms.
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    // Vertical workspace swipe and Mod+N hops.
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 120
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 100
        curve "ease-out-quad"
    }
}

// ── Autostart (autostart.lua) ────────────────────────────────────────────────
// Skipped (Hyprland-only): hyprpaper, split-dir-daemon,
// rdisplay daemon (hyprctl), xdg-desktop-portal-hyprland.
spawn-at-startup "sh" "-c" "dbus-update-activation-environment --systemd --all; systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"
spawn-at-startup "sh" "-c" "gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'"
spawn-at-startup "systemctl" "--user" "start" "hyprpolkitagent"
// spawn-at-startup does not expand "~": run through sh so $HOME resolves.
spawn-at-startup "sh" "-c" "swaybg -m fill -i $HOME/.config/wallpapers/RaBbLE_WP.PNG"
spawn-at-startup "sh" "-c" "waybar -c $HOME/.config/waybar/config-niri.jsonc"
spawn-at-startup "mako"
spawn-at-startup "sh" "-c" "$HOME/.config/rabble-shell/bin/rabble-idle"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "swayosd-server"
spawn-at-startup "sh" "-c" "uv run ~/.config/waybar/scripts/score-usage-api-poll.py"
spawn-at-startup "sh" "-c" "~/.config/waybar/scripts/score-status-daemon.sh"

// ── Keybinds (keybinds.lua + functionkeys.lua) ───────────────────────────────
// Mod = Super. niri is scrolling columns: Hyprland "window" moves become column/window actions.
binds {
    // Session
    Mod+Shift+Q repeat=false hotkey-overlay-title="Close window" { close-window; }
    Mod+Shift+E { quit; }
    Mod+Escape hotkey-overlay-title="Lock" { spawn-sh "~/.config/rabble-shell/bin/rabble-lock"; }
    Mod+F1 hotkey-overlay-title="This cheat sheet" { show-hotkey-overlay; }

    // Apps
    Mod+Return hotkey-overlay-title="Terminal (kitty)" { spawn "kitty"; }
    Mod+Space hotkey-overlay-title="Launcher (fuzzel)" { spawn "fuzzel"; }
    Mod+B { spawn "firefox"; }
    Mod+E { spawn "dolphin"; }
    Mod+Shift+C { spawn-sh "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }

    // Screenshots: niri's built-in UI (screen / region), region -> swappy as in Hyprland
    Mod+S { screenshot-screen; }
    Mod+Shift+S { spawn-sh "grim -g \"$(slurp)\" - | swappy -f -"; }
    Print { screenshot-screen; }
    Shift+Print { spawn-sh "grim -g \"$(slurp)\" - | swappy -f -"; }
    Ctrl+Print { spawn-sh "grim -g \"$(slurp)\" - | wl-copy"; }
    Alt+Print { screenshot-window; }

    // Layout (niri defaults): F widens the column to the full width (bar, gaps, border stay);
    // M fills the area down to the bar; Shift+F is true fullscreen (covers the bar). Press again to undo.
    Mod+F hotkey-overlay-title="Maximize column (bar stays)" { maximize-column; }
    Mod+M hotkey-overlay-title="Maximize to edges (bar stays)" { maximize-window-to-edges; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen (covers bar)" { fullscreen-window; }
    Mod+V hotkey-overlay-title="Float / tile toggle" { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+G { toggle-column-tabbed-display; }
    Mod+O hotkey-overlay-title="Overview: see every workspace, click to jump" { toggle-overview; }
    Mod+C { center-column; }

    // Focus (hjkl + arrows). Hyprland smart-focus = nearest in direction; niri = column/window.
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    // J/K: window above/below in a stacked column; with one window per column they change workspace.
    Mod+K { focus-window-or-workspace-up; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }

    // Move (Hyprland Shift+hjkl swap / Shift+arrows smart-move)
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }

    // Group-ish: Hyprland Alt+hjkl move into group -> pull window into the adjacent column
    Mod+Alt+H { consume-or-expel-window-left; }
    Mod+Alt+L { consume-or-expel-window-right; }
    Mod+Alt+Left { consume-or-expel-window-left; }
    Mod+Alt+Right { consume-or-expel-window-right; }
    Mod+Alt+Escape { expel-window-from-column; }
    // Hyprland addmaster / removemaster
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Resize: no submaps in niri, so Mod+R cycles preset widths and Mod+-/= nudge
    Mod+R hotkey-overlay-title="Cycle column width 1/3 · 1/2 · 2/3" { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Monitors (Hyprland Ctrl+hjkl preselect has no niri meaning, so Ctrl takes the monitor jump)
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+Left { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Up { focus-monitor-up; }
    Mod+Ctrl+Down { focus-monitor-down; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+K { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+J { move-column-to-monitor-down; }

    // Workspaces (niri workspaces are per-monitor and vertical)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }
    Mod+Tab { focus-workspace-previous; }
    Mod+BracketRight { focus-workspace-down; }
    Mod+BracketLeft { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }

    // Function keys (functionkeys.lua)
    XF86AudioMute allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; swayosd-client --input-volume mute-toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise" "--device" "amdgpu_bl1"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower" "--device" "amdgpu_bl1"; }
    XF86KbdLightOnOff { spawn-sh "~/.config/hypr/scripts/kb-brightness.sh toggle"; }
    XF86KbdBrightnessUp { spawn-sh "~/.config/hypr/scripts/kb-brightness.sh up"; }
    XF86KbdBrightnessDown { spawn-sh "~/.config/hypr/scripts/kb-brightness.sh down"; }
    XF86EmojiPicker { spawn-sh "rofimoji --selector fuzzel"; }
    XF86Launch1 { spawn "kitty" "--title" "rabble-scratch"; }
    XF86Assistant { spawn-sh "kitty --title rabble-assistant -e bash -c \"echo 'RaBbLE entity dormant // %ENTITY_DORMANT%'; bash\""; }

    Mod+Shift+P { power-off-monitors; }
}
