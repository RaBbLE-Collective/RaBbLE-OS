# free-claude-code configuration
# Copy to ~/.config/rabble/fcc.env and fill in your keys.
# Managed by: dotctl / ansible ai-harnesses role
# Spell: fcc-ctl keys

# ── Server auth ───────────────────────────────────────────────────────────────
# Token for the Admin UI at http://127.0.0.1:8082/admin
# Set to a random string or leave as fcc-no-auth (localhost-only, no network exposure)
ANTHROPIC_AUTH_TOKEN=fcc-no-auth

# ── Provider API keys ─────────────────────────────────────────────────────────
# Add keys for providers you want free-claude-code to route to.
# The Admin UI lets you set model routing per tier (Haiku/Sonnet/Opus).

# Groq — fast inference, free tier (personal key — do not share)
GROQ_API_KEY=

# Cerebras — 700+ t/s, free tier
CEREBRAS_API_KEY=

# DeepSeek — near-frontier quality at near-zero cost
DEEPSEEK_API_KEY=

# NVIDIA NIM — free tier, 100+ models
NVIDIA_API_KEY=

# Google Gemini — gemini-2.5-pro free tier
GEMINI_API_KEY=

# OpenRouter — aggregator, covers almost everything (needs $10 credit for non-free models)
OPENROUTER_API_KEY=

# Mistral — GDPR-friendly, Codestral for code
MISTRAL_API_KEY=

# Together AI — cheap open model hosting
TOGETHER_API_KEY=

# ── Model routing ─────────────────────────────────────────────────────────────
# Maps Claude tier names to the actual provider:model to use.
# Set these in the Admin UI at http://127.0.0.1:8082/admin or as env vars here.
# Example routing (uncomment and edit):

# MODEL_HAIKU=groq:llama-3.3-70b-versatile
# MODEL_SONNET=deepseek:deepseek-chat
# MODEL_OPUS=nvidia_nim:nvidia/llama-3.3-nemotron-super-49b-v1

# ── Advanced ──────────────────────────────────────────────────────────────────
# FCC_PORT=8082
# FCC_HOST=127.0.0.1
