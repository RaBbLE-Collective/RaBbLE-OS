[%General]
author=RaBbLE Collective
comment=Aether — void/neon synthwave Qt theme (KvArcDark foundation + Aether palette)
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=true
mirror_doc_tabs=true
composite=true
menu_shadow_depth=6
tooltip_shadow_depth=3
spread_progressbar=true
spread_menuitems=true
menu_separator_height=6
scroll_width=6
scroll_arrows=false
scroll_min_extent=60
transient_scrollbar=true
transient_groove=true
groupbox_top_label=false
button_icon_size=16
toolbar_icon_size=16
check_size=14
small_icon_size=16
big_icon_size=32
toolbutton_style=1
animate_states=true
dark_titlebar=true
merge_menubar_with_toolbar=true
click_behavior=0
translucent_windows=true
blurring=false
popup_blurring=false
vertical_spin_indicators=false
fill_rubberband=false
combo_as_lineedit=true
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=true
inline_spin_indicators=false
joined_inactive_tabs=false
layout_spacing=6
layout_margin=9
scrollbar_in_view=true
submenu_overlap=3
tree_branch_line=true
splitter_width=4

[GeneralColors]
window.color=#12132a
base.color=#1a1b2e
alt.base.color=#0a0010
button.color=#1a1b2e
light.color=#2a2840
mid.light.color=#12132a
dark.color=#0a0010
mid.color=#05000c
shadow.color=#0a0010
highlight.color=#ff2d78
inactive.highlight.color=#bf5fff
text.color=#e8e6f0
window.text.color=#e8e6f0
button.text.color=#e8e6f0
disabled.text.color=#6b6880
tooltip.base.color=#12132a
tooltip.text.color=#e8e6f0
highlight.text.color=#e8e6f0
link.color=#00f5ff
link.visited.color=#bf5fff
progress.indicator.text.color=#e8e6f0

[Hacks]
transparent_dolphin_view=true
blur_translucent=false
transparent_ktitle_label=true
transparent_menutitle=true
respect_darkness=true
force_size_grip=false
iconless_pushbutton=true
iconless_menu=false
middle_click_scroll=false
tint_on_mouseover=0
normal_default_pushbutton=true
single_top_toolbar=true
transparent_pcmanfm_sidepane=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=button
indicator.size=9
text.normal.color=#e8e6f0
text.focus.color=#e8e6f0
text.press.color=#00f5ff
text.toggle.color=#ff2d78
text.shadow=0
text.margin=1
text.iconspacing=4
indicator.element=arrow
text.margin.top=2
text.margin.bottom=2
text.margin.left=2
text.margin.right=2
min_width=+0.3font
min_height=+0.3font
frame.expansion=6

[PanelButtonTool]
inherits=PanelButtonCommand

[Dock]
inherits=PanelButtonCommand
interior.element=dock
frame.element=dock
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.normal.color=#e8e6f0

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#6b6880
text.focus.color=#e8e6f0
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=true
interior=true
frame.left=1
indicator.element=spin
indicator.size=10
text.normal.color=#e8e6f0

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.normal.color=#e8e6f0
text.focus.color=#00f5ff

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.normal.color=#e8e6f0
text.focus.color=#00f5ff

[Focus]
inherits=PanelButtonCommand
frame=true
frame.element=focus
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.patternsize=20

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=1
text.margin.right=1
text.focus.color=#00f5ff

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand
text.normal.color=#e8e6f0
text.press.color=#6b6880
text.focus.color=#00f5ff

[Tab]
inherits=PanelButtonCommand
interior.element=tab
text.margin.left=8
text.margin.right=8
text.margin.top=2
text.margin.bottom=2
frame.element=tab
indicator.element=tab
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.normal.color=#6b6880
text.focus.color=#b0aec0
text.toggle.color=#e8e6f0
frame.expansion=0

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabframe
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[TreeExpander]
inherits=PanelButtonCommand
indicator.size=12
indicator.element=tree

[HeaderSection]
inherits=PanelButtonCommand
interior.element=header
frame.element=header
frame.top=3
frame.bottom=3
frame.left=1
frame.right=1
text.bold=true
text.normal.color=#6b6880
text.focus.color=#00f5ff
text.toggle.color=#e8e6f0
frame.expansion=0

[SizeGrip]
indicator.element=resize-grip

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
text.margin=0
frame=false
interior.element=menubar
frame.element=menubar
text.normal.color=#e8e6f0
text.focus.color=#00f5ff
frame.bottom=0
frame.expansion=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
text.margin=0
text.normal.color=#e8e6f0
text.focus.color=#e8e6f0
text.press.color=#e8e6f0
text.toggle.color=#e8e6f0
text.bold=false
frame.expansion=8

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern

[ItemView]
inherits=PanelButtonCommand
text.margin=0
frame.element=itemview
interior.element=itemview
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.normal.color=#e8e6f0
text.focus.color=#e8e6f0
text.press.color=#00f5ff
text.toggle.color=#e8e6f0
frame.expansion=0

[Splitter]
indicator.size=48

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=10

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior=false
frame.left=6
frame.right=6
frame.top=6
frame.bottom=6
indicator.element=grip
indicator.size=13
frame.expansion=48

[ScrollbarGroove]
inherits=PanelButtonCommand
interior=false
frame=false

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.normal.color=#e8e6f0
text.focus.color=#e8e6f0
text.margin.top=1
text.margin.bottom=1
text.margin.left=15
text.margin.right=5
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
frame.expansion=0

[MenuBar]
inherits=PanelButtonCommand
frame.element=menubar
interior.element=menubar
frame.bottom=0
frame.expansion=0

[MenuBarItem]
inherits=PanelButtonCommand
interior=true
interior.element=menubaritem
frame.element=menubaritem
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=4
text.margin.right=4
text.margin.top=0
text.margin.bottom=0
text.normal.color=#e8e6f0
text.focus.color=#00f5ff
frame.expansion=0

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size=12
indicator.element=mdi
text.normal.color=#6b6880
text.focus.color=#e8e6f0
text.bold=true
text.italic=false
frame.expansion=0

[ComboBox]
inherits=PanelButtonCommand
interior.element=combo
frame.element=combo
text.press.color=#e8e6f0
indicator.element=carrow

[Menu]
inherits=PanelButtonCommand
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.element=menu
interior.element=menu
text.normal.color=#e8e6f0
text.shadow=false
frame.expansion=0

[GroupBox]
inherits=GenericFrame
frame=false
text.shadow=0
text.margin=0
text.normal.color=#6b6880
text.focus.color=#e8e6f0
text.bold=true
frame.expansion=0

[TabBarFrame]
inherits=GenericFrame
frame=true
frame.element=tabBarFrame
interior=false
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[ToolTip]
inherits=GenericFrame
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
text.shadow=0
text.margin=0
interior.element=tooltip
frame.element=tooltip
frame.expansion=0

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=true
interior.element=window
