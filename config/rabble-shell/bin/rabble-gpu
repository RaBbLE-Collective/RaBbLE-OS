#!/usr/bin/env bash
# rabble-gpu: decide which GPU the compositor renders on. Compositor-agnostic.
#
# Policy: render on the GPU that drives the internal panel (eDP/LVDS/DSI). On a hybrid laptop
# that is the iGPU, so the dGPU can stay suspended; on a desktop it is the GPU with the monitor.
# Single-GPU machines get no pin. The dGPU is for per-app offload (capability/power gated),
# never for drawing the desktop. Compositors consume this, none of them decide it:
#   niri      systemd drop-in runs `rabble-gpu write-niri` before niri starts (machine.kdl)
#   hyprland  env.lua can call `rabble-gpu aq-devices`
# RABBLE_RENDER_NODE=/dev/dri/... overrides the choice.
set -u
DRM=/sys/class/drm

cards() { for c in "$DRM"/card[0-9]*; do case "${c##*/}" in *-*) ;; *) [ -e "$c/device" ] && echo "${c##*/}" ;; esac; done; }
pci_of() { basename "$(readlink -f "$DRM/$1/device")"; }
render_of() {   # real GPUs have a render node; simpledrm/framebuffer stubs do not
    local p; p=$(pci_of "$1")
    [ -e "/dev/dri/by-path/pci-$p-render" ] && echo "/dev/dri/by-path/pci-$p-render"
}
card_path() { echo "/dev/dri/by-path/pci-$(pci_of "$1")-card"; }
gpu_cards() { local c; for c in $(cards); do [ -n "$(render_of "$c")" ] && echo "$c"; done; }

panel_card() {
    local s c
    for s in "$DRM"/card*-eDP-* "$DRM"/card*-LVDS-* "$DRM"/card*-DSI-*; do
        [ -e "$s/status" ] || continue
        [ "$(cat "$s/status")" = connected ] || continue
        c=${s##*/}; echo "${c%%-*}"; return
    done
    for s in "$DRM"/card*-*; do                      # no panel (desktop): any connected output
        [ -e "$s/status" ] && [ "$(cat "$s/status")" = connected ] || continue
        c=${s##*/}; echo "${c%%-*}"; return
    done
    gpu_cards | head -1
}

choice() {   # prints the render node to pin, or nothing when there is nothing to choose
    if [ -n "${RABBLE_RENDER_NODE:-}" ]; then echo "$RABBLE_RENDER_NODE"; return; fi
    [ "$(gpu_cards | wc -l)" -ge 2 ] || return 0
    render_of "$(panel_card)"
}

write_niri() {
    local dest="${XDG_CONFIG_HOME:-$HOME/.config}/niri/machine.kdl" node tmp
    node=$(choice); mkdir -p "$(dirname "$dest")"; tmp=$(mktemp "$dest.XXXXXX")
    {
        echo "// Generated by rabble-gpu at session start. Do not edit; see rabble-shell/bin/rabble-gpu."
        if [ -n "$node" ]; then printf 'debug {\n    render-drm-device "%s"\n}\n' "$node"
        else echo "// single GPU: nothing to pin"; fi
    } > "$tmp"
    if cmp -s "$tmp" "$dest" 2>/dev/null; then rm -f "$tmp"; else mv "$tmp" "$dest"; fi
}

case "${1:-explain}" in
    render-node) choice ;;
    aq-devices)  # colon list, panel GPU first; empty on single-GPU machines (nothing to choose)
        [ "$(gpu_cards | wc -l)" -ge 2 ] || exit 0
        p=$(panel_card); out=""
        for c in "$p" $(gpu_cards | grep -vx "$p"); do
            [ -e "$(card_path "$c")" ] && out="${out:+$out:}$(card_path "$c")"
        done
        echo "$out" ;;
    write-niri)  write_niri ;;
    explain)
        echo "gpus: $(gpu_cards | tr '\n' ' ')"; echo "panel gpu: $(panel_card)"
        echo "render node: $(choice || true)"; ;;
    *) echo "usage: rabble-gpu render-node|aq-devices|write-niri|explain" >&2; exit 2 ;;
esac
