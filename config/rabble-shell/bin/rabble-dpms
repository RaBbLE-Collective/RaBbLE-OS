#!/usr/bin/env bash
# rabble-dpms on|off — blank or wake displays on whatever compositor is running.
set -u
state="${1:-}"
case "$state" in on|off) ;; *) echo "usage: rabble-dpms on|off" >&2; exit 2 ;; esac

desktop="${XDG_CURRENT_DESKTOP,,}"
case "$desktop" in
  *hyprland*) exec hyprctl dispatch dpms "$state" ;;
  *niri*)
    if [ "$state" = off ]; then exec niri msg action power-off-monitors
    else exec niri msg action power-on-monitors; fi ;;
  *) echo "rabble-dpms: no backend for XDG_CURRENT_DESKTOP='$XDG_CURRENT_DESKTOP'" >&2; exit 1 ;;
esac
