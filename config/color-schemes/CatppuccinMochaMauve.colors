# Catppuccin Mocha Mauve — KDE color scheme
# License: MIT (https://github.com/catppuccin/kde)
# Palette: https://catppuccin.com/palette (Mocha, Mauve accent)
#
# Base: #1e1e2e | Text: #cdd6f4 | Accent (Mauve): #cba6f7
# Clean dark baseline — integrate Aether colors on top methodically.
#
# REQUIRED: [General] must be the ONLY first section — KF6 KColorScheme looks
# up Name= to match kdeglobals ColorScheme=. Duplicate [General] sections cause
# the last value to win (KConfig INI semantics), overriding the correct Name.
# ForegroundInactive matches ForegroundNormal for tiling-WM readability (no
# Plasma session means unfocused windows stay at the dimmer inactive palette).

[General]
ColorScheme=Catppuccin Mocha Mauve
Name=Catppuccin Mocha Mauve
shadeSortColumn=true

[ColorEffects:Disabled]
Color=49,52,68
ColorAmount=0.55
ColorEffect=2
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=49,52,68
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

