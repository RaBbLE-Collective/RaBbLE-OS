# {{ ansible_managed }}
# Auto-generated by ansible/roles/layer/creator-apps from vars/main.yml — do
# not edit by hand, it's rewritten on every `apply creator-apps` / `app <id>`.
# POSIX-compatible (sourced by both zsh and bash, see config/shell/zsh/.zshrc
# and config/shell/bash/.bashrc).
{% for app in rabble_optional_apps %}
{% if app.cli is defined %}
alias {{ app.cli }}='flatpak run --command={{ app.cli }} {{ app.flatpak }}'
{% endif %}
{% endfor %}
