# {{ ansible_managed }}
# RaBbLE-OS GRUB Theme — Aether Synthwave Outrun
# Source of truth: RaBbLE-Grimoire/RaBbLE-Agent/RaBbLE-Palette.md
#
# Colors:  bg #0a0010  magenta #ff2d78  cyan #00f5ff  violet #bf5fff
#          text #e8e6f0  muted #6b6880  surface #12132a  border #2a2840
#
# Background: pre-rendered at 24bpp RGB (GRUB limitation: <=24bpp) via
#   build-grub-bg.py  — composites entity + floor grid + wordmark.
#   Falls back to desktop-color if grub-bg.png is missing.
#
# Fonts are generated at deploy time by boot/grub2 Ansible role (Noto Sans).
# Font sizes are parameterised so 1080p (1920x1200) and HiDPI (3840x2400) builds
# can coexist without theme duplication — override rabble_grub_theme_* in group_vars.
# Current values:  hint={{ rabble_grub_theme_hint }}  body={{ rabble_grub_theme_body }}  sub={{ rabble_grub_theme_sub }}  title={{ rabble_grub_theme_title }}

desktop-image: "grub-bg.png"
desktop-color: "#0a0010"
title-color: "#ff2d78"
title-font: "RaBbLE UI Regular {{ rabble_grub_theme_title }}"
message-color: "#e8e6f0"
message-bg-color: "#0a0010"

# ── Title ──────────────────────────────────────────────────────────────────────
+ label {
  top    = 12%
  left   = 0
  width  = 100%
  align  = "center"
  text   = "RaBbLE-OS"
  font   = "RaBbLE UI Regular {{ rabble_grub_theme_title }}"
  color  = "#ff2d78"
}

# ── Subtitle / episode ─────────────────────────────────────────────────────────
+ label {
  top    = 22%
  left   = 0
  width  = 100%
  align  = "center"
  text   = "Episode 1 — Genesis"
  font   = "RaBbLE UI Regular {{ rabble_grub_theme_sub }}"
  color  = "#bf5fff"
}

# ── Separator line ─────────────────────────────────────────────────────────────
+ label {
  top    = 30%
  left   = 20%
  width  = 60%
  align  = "center"
  text   = "────────────────────────────────────────────────────────"
  font   = "RaBbLE UI Regular {{ rabble_grub_theme_hint }}"
  color  = "#2a2840"
}

# ── Boot menu ──────────────────────────────────────────────────────────────────
+ boot_menu {
  top                   = 33%
  left                  = 22%
  width                 = 56%
  height                = 52%
  item_font             = "RaBbLE UI Regular {{ rabble_grub_theme_body }}"
  item_color            = "#e8e6f0"
  selected_item_color   = "#ff2d78"
  item_height           = {{ (rabble_grub_theme_body * 2) | int }}
  item_padding          = {{ (rabble_grub_theme_body * 0.625) | int }}
  item_spacing          = {{ (rabble_grub_theme_body * 0.375) | int }}
  scrollbar             = false
}

# ── Key hint ───────────────────────────────────────────────────────────────────
+ label {
  top    = 89%
  left   = 0
  width  = 100%
  align  = "center"
  text   = "↑↓ select  ·  Enter boot  ·  e edit  ·  c console  ·  Esc back"
  font   = "RaBbLE UI Regular {{ rabble_grub_theme_hint }}"
  color  = "#6b6880"
}

# ── Timer / countdown ──────────────────────────────────────────────────────────
+ progress_bar {
  id          = "__timeout__"
  top         = 94%
  left        = 30%
  width       = 40%
  height      = 6
  fg_color    = "#ff2d78"
  bg_color    = "#12132a"
  border_color = "#2a2840"
}
